# Copia este fichero a `.env` y rellena la clave.
#
# La clave es TUYA: se saca de https://aistudio.google.com/apikey con tu propia
# cuenta y tu propia facturación. No se comparte por chat ni se commitea —`.env`
# está en .gitignore.
GEMINI_API_KEY=your-gemini-api-key-here

# Dónde persiste el pipeline. Un solo fichero local: no hay servidor de base de
# datos que levantar.
DB_URL=sqlite:///data/manuals.sqlite

DATA_DIR=./data
RAW_PDFS_DIR=./data/raw_pdfs
PROCESSED_DIR=./data/processed
