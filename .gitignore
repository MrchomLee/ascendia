# --- Entorno ---
# La GEMINI_API_KEY es personal: vive en .env y ahí se queda.
.env
.env.local
!.env.example

# --- Estado local de herramientas ---
.claude/

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Datos ---
# Los PDFs pesan y no son públicos; el SQLite se reconstruye desde ellos; los
# bundles son entregas, no código. Nada de esto se versiona.
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/bundles/*
!data/bundles/.gitkeep
# Intercambio con Claude Code (qgen-claude): ventanas exportadas y respuestas.
data/claude_code/
data/manuals.sqlite
data/manuals.sqlite-journal
data/manuals.sqlite-wal
data/manuals.sqlite-shm

bakeoff_report.md
*.log

# --- graphify ---
# Se versiona el grafo (graph.json, GRAPH_REPORT.md…), no su cache de
# extracción ni las copias con fecha que deja cada `graphify update`.
graphify-out/cache/
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# --- Binarios y temporales ---
*.exe
err.txt
